# Relay production environment. Names and descriptions only: copy to
# deploy/.env.production (git-ignored), fill in, and keep it out of version control.
# Generate secrets with:  openssl rand -base64 32
# Fernet key:             python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Stack ----------------------------------------------------------------------------
# Image tag used by docker compose (e.g. a git SHA).
RELAY_VERSION=
# Host port the web container is published on (put a TLS reverse proxy in front).
RELAY_WEB_PORT=3000

# --- Database (bundled Postgres container) ---------------------------------------------
# Superuser password for the container's bootstrap user. Used only for role setup and backups.
POSTGRES_SUPERUSER_PASSWORD=
# Password for relay_owner (owns schemas, runs migrations).
RELAY_OWNER_DB_PASSWORD=
# Password for relay_app (API and worker; restricted, subject to row-level security).
RELAY_APP_DB_PASSWORD=
# Using a managed database instead? Set these two directly and remove the `db` service.
# RELAY_DATABASE_URL=postgresql+psycopg://relay_app:...@host:5432/relay
# RELAY_MIGRATION_DATABASE_URL=postgresql+psycopg://relay_owner:...@host:5432/relay

# --- Backend ---------------------------------------------------------------------------
# One of: staging, production. Enables strict startup validation.
RELAY_ENVIRONMENT=production
# Public HTTPS URL of the web app (links in emails, OAuth callbacks). No trailing slash.
RELAY_FRONTEND_BASE_URL=
# Worker processes jobs concurrently up to this many (1-16).
RELAY_WORKER_CONCURRENCY=2
# Seconds running jobs get to finish on shutdown before being retried later.
RELAY_WORKER_SHUTDOWN_SECONDS=30
# Days an invitation link stays valid (1-30).
RELAY_INVITATION_TTL_DAYS=7

# --- WorkOS (authentication; production environment in the WorkOS dashboard) ------------
# Shared by web and API. Format: client_...
RELAY_WORKOS_CLIENT_ID=
WORKOS_CLIENT_ID=
# Server-side API key (sk_live_...). Required in production. Never exposed to browsers.
RELAY_WORKOS_API_KEY=
WORKOS_API_KEY=
# Session-cookie encryption password for the web app, at least 32 random characters.
WORKOS_COOKIE_PASSWORD=
# https://<your-domain>/callback (also register it in WorkOS > Redirects). Build-time value.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=
# https://api.workos.com/user_management/<client id>
WORKOS_ISSUER=

# --- Credential encryption --------------------------------------------------------------
# Fernet key that encrypts stored Linear and Notion tokens. Required if either is enabled.
# Keep a secure copy: losing or changing it means reconnecting those integrations.
RELAY_INTEGRATION_ENCRYPTION_KEY=

# --- Email via Resend (optional; blank = in-app notifications only) ---------------------
RELAY_RESEND_API_KEY=
# Verified sender, e.g. "Relay <notifications@mail.example.com>". Required with the key.
RELAY_EMAIL_FROM=
RELAY_EMAIL_REPLY_TO=
# Email via SMTP (optional; takes precedence over Resend). Gmail: smtp.gmail.com, port 587,
# starttls, your Gmail address as username and a Google *app password* (needs 2-Step
# Verification; create at https://myaccount.google.com/apppasswords). RELAY_EMAIL_FROM must
# be that same address for Gmail.
RELAY_SMTP_HOST=
RELAY_SMTP_PORT=587
RELAY_SMTP_SECURITY=starttls
RELAY_SMTP_USERNAME=
RELAY_SMTP_PASSWORD=

# --- GitHub App (optional; set all or none) ---------------------------------------------
RELAY_GITHUB_APP_ID=
RELAY_GITHUB_APP_SLUG=
RELAY_GITHUB_CLIENT_ID=
RELAY_GITHUB_CLIENT_SECRET=
# PEM private key, in double quotes, with \n line escapes.
RELAY_GITHUB_PRIVATE_KEY=
# Webhook secret (App settings > Webhook). Blank = webhooks rejected; sync still runs.
RELAY_GITHUB_WEBHOOK_SECRET=

# --- Linear OAuth app (optional; set both or neither) -----------------------------------
# Callback URL to register: <RELAY_FRONTEND_BASE_URL>/integrations/linear/callback
RELAY_LINEAR_CLIENT_ID=
RELAY_LINEAR_CLIENT_SECRET=

# --- Notion public integration (optional; set both or neither) --------------------------
# Redirect URI to register: <RELAY_FRONTEND_BASE_URL>/integrations/notion/callback
RELAY_NOTION_CLIENT_ID=
RELAY_NOTION_CLIENT_SECRET=
# Maximum pages imported per sync.
RELAY_NOTION_PAGE_LIMIT=500

# --- Logging -------------------------------------------------------------------------------
# One JSON object per line (request id, route template, status, duration). Recommended.
RELAY_JSON_LOGS=true

# --- AI (optional; blank RELAY_LLM_PROVIDERS = AI off, rule-based analysis still runs) ------
# Providers tried in order, e.g. gemini,groq. Confirm each provider's data terms for your
# account tier before sending real data (docs/release-audit/SECURITY_AND_PRIVACY_REVIEW.md S-01).
RELAY_LLM_PROVIDERS=
RELAY_GEMINI_KEY_1=
RELAY_GEMINI_KEY_2=
RELAY_GEMINI_KEY_3=
RELAY_GEMINI_KEY_4=
RELAY_GEMINI_MODEL=gemini-3.5-flash-lite
RELAY_GROQ_API_KEY=
RELAY_GROQ_MODEL=llama-3.3-70b-versatile
# Per-workspace monthly token budget.
RELAY_AI_MONTHLY_TOKEN_BUDGET=2000000
# USD per million tokens for models without a built-in price (cost reports only).
RELAY_LLM_PRICE_INPUT=
RELAY_LLM_PRICE_OUTPUT=

# --- External writes (off by default; each issue still needs a person's approval) ---------
RELAY_GITHUB_ISSUE_WRITES=false
RELAY_LINEAR_ISSUE_WRITES=false
# Use read,write only together with RELAY_LINEAR_ISSUE_WRITES=true.
RELAY_LINEAR_OAUTH_SCOPE=read

# --- Web app (read by the web container) ----------------------------------------------------
# Optional: where the Help page sends feedback.
RELAY_FEEDBACK_EMAIL=
