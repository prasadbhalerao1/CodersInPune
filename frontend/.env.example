# Copy to .env.local. Placeholders only — never commit real values.
# Values come from the WorkOS dashboard (development environment). See README.

WORKOS_CLIENT_ID="client_REPLACE_ME"
# Server-side only. Optional per the AuthKit SDK (without it, AuthKit runs as a PKCE public client).
WORKOS_API_KEY="sk_test_REPLACE_ME"
# At least 32 characters; encrypts the session cookie. Generate: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"
# Makes the SDK validate the access-token issuer too (the API always does).
WORKOS_ISSUER="https://api.workos.com/user_management/client_REPLACE_ME"

# Relay API (server-to-server only; the browser never calls it directly).
RELAY_API_URL="http://127.0.0.1:8000"

# Optional: where the Help page sends feedback (mailto).
# RELAY_FEEDBACK_EMAIL="support@example.com"
