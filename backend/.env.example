# Local development defaults (match infra/db/init/01-roles.sql). Copy to .env.
RELAY_ENVIRONMENT=local
# Application role: restricted, subject to RLS.
RELAY_DATABASE_URL=postgresql+psycopg://relay_app:relay_app_dev@localhost:5432/relay
# Owner role: used only by Alembic.
RELAY_MIGRATION_DATABASE_URL=postgresql+psycopg://relay_owner:relay_owner_dev@localhost:5432/relay
RELAY_APP_DB_ROLE=relay_app
# WorkOS (development environment). Placeholder; see README "WorkOS setup".
RELAY_WORKOS_CLIENT_ID=client_REPLACE_ME
