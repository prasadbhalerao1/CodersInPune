# Local development defaults (match infra/db/init/01-roles.sql). Copy to .env.
RELAY_ENVIRONMENT=local
# Application role: restricted, subject to RLS.
RELAY_DATABASE_URL=postgresql+psycopg://relay_app:relay_app_dev@localhost:5432/relay
# Owner role: used only by Alembic.
RELAY_MIGRATION_DATABASE_URL=postgresql+psycopg://relay_owner:relay_owner_dev@localhost:5432/relay
RELAY_APP_DB_ROLE=relay_app
# WorkOS (development environment). Placeholder; see README "WorkOS setup".
RELAY_WORKOS_CLIENT_ID=client_REPLACE_ME
# WorkOS server API key (invitation emails and verified-email lookups). Server-side only.
RELAY_WORKOS_API_KEY=
RELAY_FRONTEND_BASE_URL=http://localhost:3000
RELAY_INVITATION_TTL_DAYS=7
# GitHub App (optional; see README "GitHub App setup"). Leave blank to disable the integration.
RELAY_GITHUB_APP_ID=
RELAY_GITHUB_APP_SLUG=
RELAY_GITHUB_CLIENT_ID=
RELAY_GITHUB_CLIENT_SECRET=
# PEM in double quotes; multi-line or with \n escapes.
RELAY_GITHUB_PRIVATE_KEY=
# Email via Resend (optional). Unset = in-app notifications only; invitations via WorkOS.
RELAY_RESEND_API_KEY=
RELAY_EMAIL_FROM=
RELAY_EMAIL_REPLY_TO=
# Email via SMTP (optional; takes precedence over Resend). Gmail: smtp.gmail.com, port 587,
# starttls, your Gmail address as username and a Google *app password* (needs 2-Step
# Verification; create at https://myaccount.google.com/apppasswords). RELAY_EMAIL_FROM must
# be that same address for Gmail.
RELAY_SMTP_HOST=
RELAY_SMTP_PORT=587
RELAY_SMTP_SECURITY=starttls
RELAY_SMTP_USERNAME=
RELAY_SMTP_PASSWORD=

# --- AI model providers (tried in order of RELAY_LLM_PROVIDERS; empty = AI off) ---
# e.g. RELAY_LLM_PROVIDERS=gemini,groq,ollama
RELAY_LLM_PROVIDERS=
# Gemini: up to 4 keys; when one hits its quota Relay moves to the next.
RELAY_GEMINI_KEY_1=
RELAY_GEMINI_KEY_2=
RELAY_GEMINI_KEY_3=
RELAY_GEMINI_KEY_4=
RELAY_GEMINI_MODEL=gemini-3.5-flash-lite
# Groq (optional fallback)
RELAY_GROQ_API_KEY=
RELAY_GROQ_MODEL=llama-3.3-70b-versatile
# NVIDIA API catalog (build.nvidia.com), OpenAI-compatible
RELAY_NVIDIA_API_KEY=
RELAY_NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Ollama (local; optional fallback)
RELAY_OLLAMA_URL=http://127.0.0.1:11434/v1
RELAY_OLLAMA_MODEL=
# USD per million tokens for models without a built-in price (cost reports only).
# Take them from your provider's pricing page.
RELAY_LLM_PRICE_INPUT=
RELAY_LLM_PRICE_OUTPUT=

# --- Runtime switches (the values shown are the defaults unless noted) ---
# Run the job worker inside the API process. `scripts/setup.py` sets this to true for local
# use; production runs a separate `relay-worker` and leaves it false.
RELAY_EMBEDDED_WORKER=false
# Let signed-in users create the synthetic "Northwind Labs (demo)" workspace.
RELAY_SAMPLE_WORKSPACES=true
# Structured JSON logs with correlation ids (recommended in production).
RELAY_JSON_LOGS=false
# Database pool: connections kept open, extra ones allowed under load, and how long a
# request waits for one before failing.
RELAY_DB_POOL_SIZE=5
RELAY_DB_MAX_OVERFLOW=5
RELAY_DB_POOL_TIMEOUT_SECONDS=30
# Monthly AI token budget per workspace (0 = no AI calls).
RELAY_AI_MONTHLY_TOKEN_BUDGET=2000000

# --- Secrets that are optional locally ---
# Fernet key that encrypts stored Linear and Notion tokens. `scripts/setup.py` generates one;
# required in staging/production when either integration is configured.
RELAY_INTEGRATION_ENCRYPTION_KEY=
# GitHub App webhook secret. Unset = webhooks are rejected (503).
RELAY_GITHUB_WEBHOOK_SECRET=
# Operator token for /health/ops (aggregate alerting counts). Unset = endpoint hidden.
RELAY_OPS_TOKEN=

# --- Linear and Notion (optional; set the ID and the secret together) ---
# Redirect URIs: {frontend}/integrations/linear/callback and {frontend}/integrations/notion/callback
RELAY_LINEAR_CLIENT_ID=
RELAY_LINEAR_CLIENT_SECRET=
RELAY_NOTION_CLIENT_ID=
RELAY_NOTION_CLIENT_SECRET=
# Create-only issue writes for approved Relay tasks. Off until the provider permission exists
# (GitHub App "Issues: Read and write"; Linear scope including issues:create).
RELAY_GITHUB_ISSUE_WRITES=false
RELAY_LINEAR_ISSUE_WRITES=false
RELAY_LINEAR_OAUTH_SCOPE=read
